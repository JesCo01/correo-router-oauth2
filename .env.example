# Copia este archivo a .env. .env NO se sube a Git.
# Las contrasenas no van en config.json: el panel las guarda aqui.

# Outlook usa el identificador fijo incorporado. No requiere configurar Client ID.

# Contrasenas de aplicacion (solo cuentas con auth=app_password).
# Nombre = CORREO_ + ID de la cuenta en mayusculas + _PASSWORD
# Ejemplo para la cuenta con id "gmail_trabajo":
CORREO_GMAIL_TRABAJO_PASSWORD=
